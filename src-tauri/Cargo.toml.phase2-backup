[package]
name = "omnipilot-ai"
version = "0.1.0"
description = "OmniPilot AI - Compact Floating Windows AI Copilot"
authors = ["OmniPilot Team"]
edition = "2021"

[lib]
name = "omnipilot_ai_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2.12", features = [] }

[dependencies]
tauri = { version = "2.12", features = [] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
